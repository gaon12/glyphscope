{
  "name": "glyphscope",
  "version": "1.3.0",
  "description": "Unicode character classification library for Node.js and modern browsers",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    }
  },
  "sideEffects": false,
  "engines": {
    "node": ">=14"
  },
  "scripts": {
    "test": "node tests/index.test.js",
    "lint": "node --check src/index.js && node --check tests/index.test.js",
    "build": "babel src --out-dir dist --copy-files"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gaon12/glyphscope.git"
  },
  "keywords": [
    "unicode",
    "script",
    "hangul",
    "latin",
    "classification",
    "glyph"
  ],
  "author": "Jeong Gaon",
  "license": "MIT",
  "files": [
    "src/",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@babel/cli": "^7.28.0",
    "@babel/core": "^7.28.0"
  }
}
